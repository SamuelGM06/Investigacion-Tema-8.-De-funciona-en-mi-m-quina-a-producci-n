# ---------------------------------------------------------------
# Plantilla de variables de entorno para docker compose.
# Copiar a ".env" (que está en .gitignore) y poner valores reales:
#     cp .env.example .env
# NUNCA subir el archivo .env al repositorio.
# ---------------------------------------------------------------

# Contraseña del usuario "sa" de SQL Server (mín. 8 caracteres, mayúsculas,
# minúsculas, números y símbolos; si no cumple, el contenedor no arranca).
MSSQL_SA_PASSWORD=CambiarEsta.Clave123

# Llave para firmar los JWT (mín. 32 caracteres). Generar una con:
#     openssl rand -base64 32
JWT_KEY=reemplazar-por-una-llave-larga-y-aleatoria-de-32+

# Puertos expuestos en la máquina anfitriona
API_PORT=8080
WEB_PORT=4200
